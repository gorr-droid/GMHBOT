{
  "name": "gmh-bot",
  "version": "2.0.0",
  "private": true,
  "description": "Aurum Desk trading community update for the existing GMH Discord bot",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "check-config": "node --env-file-if-exists=.env src/main.mjs check-config",
    "install-rules": "node --env-file-if-exists=.env src/main.mjs install-rules",
    "preview": "node src/gold-drafts.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "discord.js": "14.28.1",
    "parse5": "8.1.1"
  }
}
