# Keep the existing host credentials. An optional ID pins the same Discord application.
AURUM_DISCORD_APPLICATION_ID=
BOT_TOKEN=
# The original DISCORD_TOKEN alias is also supported.
AURUM_TELEGRAM_BOT_TOKEN=
# Optional. Set to the existing Member role ID to enable rules acceptance.
DISCORD_MEMBER_ROLE_ID=
# On a hosted service, replace this with a directory on its persistent volume.
AURUM_DATA_DIR=.aurum-data
